    "    resto_do_numero = n // 10   \n",
    "\n",
    "    return ultimo_digito + soma_digitos(resto_do_numero)\n",
    "\n",
    "\n",
    "# Testando\n",
    "print(soma_digitos(123))   \n",
    "print(soma_digitos(9999))  \n",
